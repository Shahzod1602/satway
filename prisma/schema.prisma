// SAT Platform — Prisma schema
// MVP: Reading & Writing + Math (auto-graded).
// SAT has 2 sections: Reading & Writing (Module 1 + 2), Math (Module 1 + 2).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Users & auth
// ─────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  password          String
  role              Role      @default(STUDENT)
  emailVerified     Boolean   @default(false)
  verifyToken       String?
  verifyTokenExpiry DateTime?
  // Telegram Login Widget identity (null for email/password accounts).
  telegramId        String?   @unique
  telegramUsername  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  avatarUrl          String?
  country            String?
  nativeLanguage     String?
  phone              String?
  targetScore        Int? // goal score, e.g. 1400
  targetMathScore    Int? // 200-800
  targetRWScore      Int? // 200-800
  level              TestLevel? // self-selected practice level (null = not chosen; UI suggests one)
  examDate           DateTime?
  defaultType        TestType  @default(DIGITAL)
  emailNotifications Boolean   @default(true)
  plan               Plan      @default(FREE)
  premiumUntil       DateTime?
  // Win-back: when we last sent the "your Premium expired" message for the
  // current expiry. Re-armed on renewal because premiumUntil moves past it.
  winbackSentAt      DateTime?

  // Subscription gate: unlock the app by following on Instagram + joining the
  // Telegram channel. Set once (gate is shown a single time, at first entry).
  igFollowedAt    DateTime? // honor-system "I followed on Instagram" click
  tgSubVerifiedAt DateTime? // verified via Telegram Bot API getChatMember

  // ── Streak, as a derived cache ──
  // The streak is still DERIVABLE from TestAttempt.submittedAt, and the page reads
  // recompute it. These columns exist so the nudge cron can ask "who is about to lose a
  // streak?" with one indexed query instead of loading every attempt for every user.
  //
  // currentStreak is only true AS OF lastActiveDay — a stored 5 means nothing on its own
  // once two days have passed. Never render it raw; go through effectiveStreak().
  currentStreak  Int     @default(0)
  longestStreak  Int     @default(0)
  lastActiveDay  String? // Asia/Tashkent calendar day, "YYYY-MM-DD" (see src/lib/streak.ts)

  // Day-2 nudge: the single biggest retention hole. Stamped once, ever — this is a
  // "you signed up and vanished" message, not a recurring newsletter.
  nudgeSentAt    DateTime?
  welcomeSentAt  DateTime? // welcome email at registration

  referralCode     String?  @unique
  referredById     String?
  referredBy       User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals        User[]   @relation("Referrals")
  referralRewarded Boolean  @default(false)

  attempts        TestAttempt[]
  supportMessages SupportMessage[]
  payments        Payment[]
  shareLinks      ShareLink[]      @relation("ShareCreator") // links this user created
  shareLinkUses   ShareLinkUse[] // links this user redeemed
  liveHosted      LiveSession[]    @relation("LiveHost") // live sessions this user hosts
  liveJoined      LiveParticipant[] // live sessions this user joined
  events          Event[]          @relation("UserEvents") // SetNull on delete — see Event
  promoCodes      PromoCode[]      @relation("PromoOwner") // codes this user earns on
  promoEarnings   Payment[]        @relation("PromoEarnings") // sales made with those codes
  vocabProgress   VocabProgress[]
}

// ─────────────────────────────────────────────────────────────
// Manual payments — user submits, admin approves to grant Premium
// ─────────────────────────────────────────────────────────────

model Payment {
  id         String        @id @default(cuid())
  userId     String
  planLabel  String // "1m" | "3m" | "6m"
  months     Int
  amount     Int           @default(0) // what they actually owe, AFTER any promo discount
  status     PaymentStatus @default(PENDING)
  note       String? // user-supplied note / payment reference
  proofUrl   String? // optional uploaded receipt
  reviewedAt DateTime?
  reviewedBy String? // admin user id
  createdAt  DateTime      @default(now())

  /// Human-readable reference, e.g. "SW-000042".
  ///
  /// Today it is what a student quotes in a Telegram message so an admin can find their
  /// transfer. It is also exactly what every UZ payment provider needs as its account
  /// key — Payme and Click both identify an order by one opaque merchant-side id — so
  /// the seam is here rather than bolted on later.
  ///
  /// Not nullable: a payment without a reference is one a human cannot find. Adding it
  /// as SERIAL numbers the existing rows on the way in.
  orderNo    Int           @unique @default(autoincrement())

  /// How this was paid. "manual" = bank-card transfer approved by hand; "click" =
  /// Click SHOP-API, granted by the Complete webhook with no human in the loop.
  provider   String        @default("manual")

  // ── Provider state (null on manual rows) ──
  clickPrepareId Int? // issued at Prepare, must be echoed at Complete
  providerRef    String? // the provider's transaction id, e.g. "click:1234567" / "payme:<id>"
  paidAt         DateTime? // when the provider confirmed money moved

  // ── Payme state machine (see src/lib/payme.ts) ──
  paymeTransId      String?   @unique // Payme's transaction id — every Payme method looks the row up by it
  paymeState        Int? // 1 created · 2 performed · -1 cancelled · -2 cancelled after perform
  paymeCreatedAt    DateTime? // our create_time for this Payme transaction
  paymeCancelledAt  DateTime? // our cancel_time
  paymeCancelReason Int? // Payme's cancellation reason code (1-5; 4 = 12h timeout)

  // ── Polar state (see src/lib/polar.ts) ──
  /// US cents the card is actually charged (discounted plan + card fee). The webhook
  /// enforces the paid order's net_amount against this; `amount` above keeps carrying
  /// the UZS equivalent so revenue queries and commission stay in one currency.
  amountUsd       Int?
  polarCheckoutId String? // Polar checkout session id — the support handle before an order exists

  // ── Promo snapshot ──
  // Snapshots, not joins. A promo's percentage can be edited and its owner reassigned;
  // if commission were computed by joining to PromoCode as it is TODAY, editing a code
  // would silently rewrite the history of what everyone was already owed.
  promoCode       String? // the code as typed, uppercased
  promoOwnerId    String? // who earns commission on this sale (see PromoCode.ownerId)
  discountPercent Int     @default(0)
  /// The commission rate AS IT WAS when this sale happened. Snapshotting the owner but
  /// not the rate would leave the same hole one level down: renegotiate a teacher from
  /// 50% to 30% and every historical payout silently drops.
  commissionPct   Int     @default(0)
  baseAmount      Int     @default(0) // list price before the discount

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoOwner User?     @relation("PromoEarnings", fields: [promoOwnerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([promoOwnerId])
}

/// A discount code. Optionally owned by someone who earns commission on what it sells.
///
/// This is the distribution channel: in this market students come through teachers and
/// learning centres, and a code with a name on it is how you find out which ones. There
/// is deliberately no TEACHER role — an owner is just a User, the same call share links
/// already make.
model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique // stored uppercase; compared uppercase
  percentOff     Int // 1-100
  ownerId        String? // earns commission; null = a plain marketing code
  commissionPct  Int       @default(0) // % of the PAID amount the owner earns
  maxUses        Int? // null = unlimited
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  note           String?
  createdAt      DateTime  @default(now())

  owner User? @relation("PromoOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

enum PaymentStatus {
  PENDING
  APPROVED // paid — by admin review (manual) or a provider webhook (click)
  REJECTED // admin declined a manual transfer
  CANCELLED // the provider reported failure/cancellation before money moved
  REFUNDED // a provider reversed an APPROVED payment — Premium needs a human review
}

model SupportMessage {
  id          String   @id @default(cuid())
  userId      String
  body        String
  fromAdmin   Boolean  @default(false)
  readByUser  Boolean  @default(false)
  readByAdmin Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Plan {
  FREE
  PREMIUM
}

model EmailOtp {
  id         String   @id @default(cuid())
  email      String   @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  verified   Boolean  @default(false) // code confirmed; account may now be created
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

enum Role {
  STUDENT
  ADMIN
}

// ─────────────────────────────────────────────────────────────
// Tests → Sections (Modules) → Questions
// ─────────────────────────────────────────────────────────────

model Test {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  skill       SatSkill
  type        TestType @default(DIGITAL)
  description String?
  durationSec Int      @default(3900) // R&W 64min, Math 70min
  published   Boolean  @default(false)
  isPremium   Boolean  @default(true) // access gate: false = playable on the free plan
  level       TestLevel @default(MEDIUM) // difficulty band shown to students; admin-set
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections     Section[]
  attempts     TestAttempt[]
  shareLinks   ShareLink[]
  liveSessions LiveSession[]
}

enum SatSkill {
  READING_WRITING
  MATH
}

enum TestType {
  DIGITAL
  PAPER
}

model Section {
  id           String            @id @default(cuid())
  testId       String
  order        Int // display order
  module       Int               @default(1) // 1 = Module 1, 2 = Module 2
  difficulty   SectionDifficulty @default(STANDARD) // M1 = STANDARD; M2 = EASY | HARD (adaptive)
  title        String? // "Module 1" / "Module 2 (Harder)"
  instructions String?
  passageText  String? // legacy shared passage (HTML); per-question stimulus preferred
  imageUrl     String? // Math diagram / graph (section-wide)
  formulaSheet Boolean           @default(false) // show SAT formula reference for Math

  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([testId])
  @@index([testId, module, difficulty])
}

// Adaptive difficulty of a section. Module 1 is always STANDARD; Module 2 is
// served as EASY or HARD depending on Module 1 performance.
enum SectionDifficulty {
  STANDARD
  EASY
  HARD
}

model Question {
  id             String       @id @default(cuid())
  sectionId      String
  order          Int
  type           SatQuestionType
  groupTitle     String? // shared passage heading e.g. "Questions 1–5 refer to the following passage."
  stimulus       String? // per-question passage / text (R&W digital split-screen, HTML)
  imageUrl       String? // per-question figure / graph
  prompt         String? // the question stem
  explanation    String? // shown on the results page after submission
  options        Json? // choices: ["A) ...", "B) ..."]
  correctAnswers Json // acceptable answers, e.g. ["B"] or ["12.5","25/2"]
  points         Int          @default(1)
  difficulty     QuestionDifficulty? // item difficulty for analytics + targeted practice
  meta           Json? // { omitCalculator: true, passageRef, etc. }

  section Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@index([sectionId])
}

// Per-question difficulty (distinct from a section's adaptive band). Nullable —
// older items are untagged until backfilled.
enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

// Whole-test difficulty band, used to match a test to a student's level.
// (Distinct from per-question QuestionDifficulty and adaptive SectionDifficulty.)
enum TestLevel {
  EASY
  MEDIUM
  HARD
}

enum SatQuestionType {
  MCQ_SINGLE
  STUDENT_PRODUCED_RESPONSE // Math grid-in: integer or fraction
  PARAGRAPH_REFERENCE // "Which choice best describes..."
  CROSS_TEXT_CONNECTIONS
  TEXTUAL_EVIDENCE
  INFERENCE
  CENTRAL_IDEAS
  WORDS_IN_CONTEXT
  TEXT_STRUCTURE
  RHETORICAL_SYNTHESIS // R&W: synthesis notes
  TRANSITIONS
  BOUNDARIES // grammar
  FORM_STRUCTURE // poetry/play analysis
  DATA_ANALYSIS // graph/table interpretation
  ALGEBRA
  ADVANCED_MATH
  PROBLEM_SOLVING
  GEOMETRY
}

// ─────────────────────────────────────────────────────────────
// Attempts & answers
// ─────────────────────────────────────────────────────────────

model TestAttempt {
  id             String        @id @default(cuid())
  userId         String
  testId         String
  status         AttemptStatus @default(IN_PROGRESS)
  startedAt      DateTime      @default(now())
  submittedAt    DateTime?
  rawScore       Int? // number correct
  totalQuestions Int?
  scaledScore    Int? // 200-800 for full section, null for module-only practice
  module         Int? // 1 or 2 for single-module practice; null = full test

  // Adaptive full-test state
  module1Raw        Int? // raw correct in Module 1 (drives Module 2 routing)
  module2Difficulty SectionDifficulty? // EASY | HARD variant served for Module 2

  // Server-side timing / integrity
  moduleStartedAt DateTime? // when the current module was served (enforces the per-module limit)
  flagged         Boolean   @default(false) // a module submitted past the time limit → excluded from the leaderboard

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  test    Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@index([userId])
  @@index([testId])
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

model AttemptAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  response   Json
  isCorrect  Boolean @default(false)
  timeSpent  Int? // seconds the student spent on this question (pacing analytics)

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// A premium user shares one test via a link. FRIEND links are capped at 3 distinct
// redeemers; CLASS links (teacher-style) are uncapped. Redeeming grants access to
// that one test only — not full Premium.
enum ShareKind {
  FRIEND
  CLASS
}

model ShareLink {
  id          String    @id @default(cuid())
  token       String    @unique
  testId      String
  createdById String
  kind        ShareKind @default(FRIEND)
  maxUses     Int? // 3 for FRIEND, null = unlimited (CLASS)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  test      Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  createdBy User           @relation("ShareCreator", fields: [createdById], references: [id], onDelete: Cascade)
  uses      ShareLinkUse[]

  @@index([createdById])
  @@index([testId])
}

model ShareLinkUse {
  id          String   @id @default(cuid())
  shareLinkId String
  userId      String
  createdAt   DateTime @default(now())

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shareLinkId, userId]) // one slot per distinct redeemer
  @@index([userId])
}

// A host-controlled LIVE session: participants join a lobby by code, then the host
// starts everyone together. Uncapped. Real-time state is polled from the DB.
enum LiveStatus {
  LOBBY
  LIVE
  ENDED
}

model LiveSession {
  id        String     @id @default(cuid())
  code      String     @unique // short join code
  testId    String
  hostId    String
  status    LiveStatus @default(LOBBY)
  startedAt DateTime?
  createdAt DateTime   @default(now())

  test         Test              @relation(fields: [testId], references: [id], onDelete: Cascade)
  host         User              @relation("LiveHost", fields: [hostId], references: [id], onDelete: Cascade)
  participants LiveParticipant[]

  @@index([hostId])
}

model LiveParticipant {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  joinedAt  DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Vocabulary — spaced repetition
// ─────────────────────────────────────────────────────────────

/// One learner's memory of one word.
///
/// This used to be a Set<string> of "known" ids in localStorage, which had three
/// problems: it vanished on a device change, it was invisible to every dashboard, and
/// "known" is not a thing you either are or aren't — you forget. A Leitner box plus a due
/// date is the smallest model that expresses forgetting (see src/lib/srs.ts).
///
/// wordId is the slug from VOCAB_DECKS (src/lib/vocabulary.ts) — deliberately NOT a
/// foreign key, because the deck is static data in the repo, not a table. A word removed
/// from the deck leaves a harmless orphan row rather than breaking a delete.
model VocabProgress {
  id             String    @id @default(cuid())
  userId         String
  wordId         String
  box            Int       @default(0) // 0..5 — see SRS_INTERVALS_DAYS
  dueAt          DateTime  @default(now())
  correctCount   Int       @default(0)
  wrongCount     Int       @default(0)
  lastReviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, dueAt]) // "what is due for this student right now" — the only hot query
}

// ─────────────────────────────────────────────────────────────
// Analytics + the AI cost ledger
// ─────────────────────────────────────────────────────────────

// One append-only table serving two jobs: what people do, and what we pay for it.
// Written only by src/lib/events.ts. See src/lib/surfaces.ts for the closed vocabulary.
model Event {
  // Int, not BigInt: BigInt throws inside JSON.stringify, and this repo serialises
  // server data to client components that way. 2.1B rows is centuries at this volume.
  id      Int      @id @default(autoincrement())
  ts      DateTime @default(now())
  name    String // closed verb set — src/lib/surfaces.ts
  surface String // closed section set — src/lib/surfaces.ts. Never "".
  // The categorical sub-dimension you GROUP BY:
  //   ai_call → model id · blocked → reason · error → the failing operation
  // "" rather than NULL, so a GROUP BY has no NULL bucket.
  key     String   @default("")
  itemId  String? // the entity: testId / questionId / shareLinkId
  userId  String? // null = signed out, or anonymised after account deletion

  // SNAPSHOT of the plan AT EVENT TIME. Without it, every retrospective question
  // ("what did free users do before they upgraded?") silently answers with today's
  // plan rather than the one that was true then.
  plan   String @default("") // FREE | PREMIUM
  // Separates recurring per-user cost of goods sold from one-off content CAPEX.
  // Admin test generation is AI spend, but it is NOT what a user costs — without
  // this column it silently inflates every per-user figure.
  origin String @default("USER") // USER | ADMIN | SCRIPT | CRON | BOT

  ms  Int? // duration: AI call latency, session length
  pct Int? // 0-100: progress through an item
  ok  Boolean @default(true)

  // ── The AI cost ledger. Typed integer columns, never a JSON blob: you cannot
  //    re-price history by modality if the tokens are buried in JSON, and
  //    SUM((props->>'usd')::numeric) is a cast-per-row scan with no schema. ──
  model       String? // the RESOLVED model id — satway defaults to gemini-2.5-pro,
  // which costs 4x flash on input and 4x on output. Pricing it model-blind would
  // under-report the tutor by exactly the multiple that matters.
  inTextTok   Int?
  inAudioTok  Int? // unused today (no audio surface) — kept so the rate card and the
  // re-pricing UPDATE stay identical to the sister app's, which already bills audio.
  inCachedTok Int? // context-cache reads bill at a large discount
  outTextTok  Int?
  outAudioTok Int?
  thinkTok    Int? // bills as OUTPUT. 2.5-pro has thinking ON unless told otherwise.
  images      Int? // image models bill PER IMAGE, not per token
  usdMicros   Int? // integer micro-USD, priced at write time by src/lib/aiPricing.ts.
  // Integer, not float: money does not round-trip through binary fractions.
  priceRev    String? // which rate card produced usdMicros → re-price ALL history with one UPDATE
  // A $0 row. Demand stays visible even when the call was free, "$ saved by cache"
  // becomes measurable, and a COLLAPSING hit rate becomes alarmable.
  cacheHit    Boolean @default(false)
  // usdMicros came from a floor rather than real usageMetadata.
  estimated   Boolean @default(false)
  retries     Int? // every retry that reached the model was still billed
  attemptId   String? // soft ref to TestAttempt.id — deliberately NO foreign key, so a
  // cascade-deleted attempt cannot poison a batched INSERT.

  // The long tail: score, accuracy, an error message. Never queried in a hot path.
  // NEVER prompts or student messages — a liability with no analytic payoff.
  props Json?

  // The ONLY foreign key, and SetNull rather than Cascade on purpose: deleting an
  // account must anonymise the behavioural trail but MUST NOT erase the money we
  // spent on that person. It was spent. The row carries no personal data.
  user User? @relation("UserEvents", fields: [userId], references: [id], onDelete: SetNull)

  @@index([ts]) // pruning + global time windows
  @@index([name, ts]) // the workhorse: name='ai_call' | 'blocked' | 'view' over a window
  @@index([surface, ts]) // the section board
  @@index([userId, ts]) // per-user timeline + the whale drill-down
}

/// The REAL Google invoice, typed in once a month.
/// Without this the cost board is a guess: the rate card is a model, not accounting.
/// Every cost screen prints "estimated $X · actual $Y · drift +Z%".
model AiBillMonth {
  month          String   @id // "2026-07" (UTC)
  actualUsdCents Int
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// One admin announcement, and what actually happened when it went out.
///
/// The counts are a SNAPSHOT taken at send time, not a live join. A "sent to 412 free
/// students" that silently becomes 380 next month as people upgrade is not history — and
/// history is the only reason to keep this row at all.
model Broadcast {
  id        String   @id @default(cuid())
  body      String
  audience  String // ALL | FREE | PREMIUM | USERS — see src/lib/broadcastAudience.ts
  channels  String // comma-separated: inapp,telegram,email
  createdAt DateTime @default(now())
  createdBy String? // admin user id

  recipients        Int @default(0) // matched the audience
  inappSent         Int @default(0)
  telegramSent      Int @default(0)
  telegramFailed    Int @default(0)
  emailSent         Int @default(0)
  emailFailed       Int @default(0)

  /// Telegram/email delivery runs in the background after the response is returned, so
  /// the row is written first with zeros and updated when the send finishes. A row stuck
  /// at "pending" means the process died mid-broadcast — which you want to be able to see.
  deliveredAt DateTime?

  @@index([createdAt])
}

/// Fire each budget alert exactly once per (day, kind, target).
model AiAlert {
  id        String   @id @default(cuid())
  day       String // "2026-07-16" (UTC)
  kind      String // daily_50 | daily_80 | daily_100 | user_spike
  target    String   @default("") // userId for user_spike, "" for global
  createdAt DateTime @default(now())

  @@unique([day, kind, target])
}
